[Unit]
Description=Toolkit app
After=network.target
Requires=docker.service

[Service]
Type=simple
User=#user
Group=#group
WorkingDirectory=#path to app directory
ExecStart=/usr/bin/docker compose up    # verify path: which docker
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
